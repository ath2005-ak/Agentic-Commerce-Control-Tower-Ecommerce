# Optional — leave unset to run in mock payment mode (zero setup, full demo works).
# Set both to switch to real Razorpay test-mode API calls.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional — leave unset to use the built-in rule-based agent (no external
# dependency, works offline). Set either to signal you've wired an LLM into
# agent.py's interpret() function in place of keyword matching.
OPENAI_API_KEY=
GOOGLE_API_KEY=
